{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoiyu915-droid/StyleAttractorLab/schemas/recipe.schema.json",
  "title": "Style recipe v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "attractors", "suppressions", "guardrails"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "attractors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        }
      }
    },
    "suppressions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

