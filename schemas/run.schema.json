{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoiyu915-droid/StyleAttractorLab/schemas/run.schema.json",
  "title": "Frozen run manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "status", "model", "recipe_id", "source_recipe", "source_eval_suite", "source_rubric", "prompt_mode", "files"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["awaiting_outputs", "generated", "scored"]},
    "model": {"type": "string", "minLength": 1},
    "recipe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "source_recipe": {"type": "string", "minLength": 1},
    "source_eval_suite": {"type": "string", "minLength": 1},
    "source_rubric": {"type": "string", "minLength": 1},
    "prompt_mode": {"enum": ["single_turn", "multi_turn"]},
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiled_style.md", "recipe.yaml", "prompts.jsonl", "rubric.yaml"],
      "properties": {
        "compiled_style.md": {"$ref": "#/$defs/sha256"},
        "recipe.yaml": {"$ref": "#/$defs/sha256"},
        "prompts.jsonl": {"$ref": "#/$defs/sha256"},
        "rubric.yaml": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
