{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoiyu915-droid/StyleAttractorLab/schemas/rubric.schema.json",
  "title": "Evaluation rubric v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "scale", "dimensions"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {"min": {"type": "integer"}, "max": {"type": "integer"}}
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "direction", "anchors"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "description": {"type": "string", "minLength": 1},
          "direction": {"enum": ["higher_is_better", "lower_is_better"]},
          "anchors": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string"}}
        }
      }
    }
  }
}
