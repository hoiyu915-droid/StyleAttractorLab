{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoiyu915-droid/StyleAttractorLab/schemas/attractor.schema.json",
  "title": "Style attractor v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "summary", "reaction_path", "attention", "syntax", "social_contract", "epistemics", "closure", "affect", "prompt_cues", "failure_modes"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "reaction_path": {"$ref": "#/$defs/stringList"},
    "attention": {"$ref": "#/$defs/stringList"},
    "syntax": {"$ref": "#/$defs/settings"},
    "social_contract": {"$ref": "#/$defs/settings"},
    "epistemics": {"$ref": "#/$defs/settings"},
    "closure": {"$ref": "#/$defs/settings"},
    "affect": {"$ref": "#/$defs/settings"},
    "prompt_cues": {"$ref": "#/$defs/stringList"},
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "avoidance"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "description": {"type": "string", "minLength": 1},
          "avoidance": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "stringList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "settings": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "boolean", "number"]}}
  }
}

